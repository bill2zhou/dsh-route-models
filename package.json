{
  "name": "dsh-route-models",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Route Models — 在 dsh 里装上这个插件即可，无需登录、注册或填 API Key，就能使用包括 DeepSeek V4.1 Flash、Kimi K3 在内的前沿模型；2.0 起接入 LobsterAI、Qoder、TRAE、Cline、Loomy、Raccoon、MiniMax、ZCode、Gemini 十个账号渠道（原有匿名免费通道保留）（登录、账号池、积分领取、本地 OpenAI 网关与局域网转发、数据看板与运行日志），六页毛玻璃界面统一呈现。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ebony-Vinyl/dsh-route-models.git"
  },
  "homepage": "https://github.com/Ebony-Vinyl/dsh-route-models",
  "bugs": {
    "url": "https://github.com/Ebony-Vinyl/dsh-route-models/issues"
  },
  "main": "./index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "test:contributor": "node scripts/test-all.mjs --mode contributor",
    "test:release": "node scripts/test-all.mjs --mode release",
    "channel-pack": "node scripts/build-channel-pack.mjs",
    "selftest": "node scripts/host-selftest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:legacy-payload": "node scripts/build-legacy-payload.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "adapter",
    "src/adapter.js",
    "src/anthropic.js",
    "src/bun-fetch.js",
    "src/catalog.js",
    "src/chan-relay.js",
    "src/channel.js",
    "src/deferred-response.js",
    "src/disclaimer.js",
    "src/effort.js",
    "src/egress.js",
    "src/failure.js",
    "src/feed.js",
    "src/forward.js",
    "src/gemini.js",
    "src/http.js",
    "src/image-pricing.js",
    "src/kilo.js",
    "src/local-optimize.js",
    "src/loopback-fetch.js",
    "src/messages.js",
    "src/model-test.js",
    "src/open-external.js",
    "src/probe.js",
    "src/push.js",
    "src/recovery.js",
    "src/reload.js",
    "src/store.js",
    "src/stream.js",
    "src/subscription-adapter.js",
    "src/subscription-completion.js",
    "src/subscriptions.js",
    "src/trust.js",
    "src/install-kind.js",
    "src/upstream.js",
    "src/vault-anchor.js",
    "src/vault-data.js",
    "src/vault.js",
    "src/token-saver.js",
    "src/core.js",
    "src/route",
    "src/o2a.js",
    "vendor/channel-pack/pack.js",
    "vendor/channel-pack/qoder-auth-wasm.wasm",
    "vendor/channel-pack/NOTICE.md",
    "vendor/channel-pack/LICENSE",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "free-model",
    "llm-provider"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dsh-llm-legacy": "npm:@deepseek-ai/dsh-llm@0.1.5-rc.2",
    "esbuild": "0.25.9",
    "jose": "^6.2.15",
    "typescript": "^5.9.2",
    "undici": "8.11.2"
  },
  "overrides": {
    "dsh-llm-legacy": {
      "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
      "@deepseek-ai/dsh-timeout": "0.1.5-rc.2",
      "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
      "@deepseek-ai/dsh-util-crypto": "0.1.5-rc.2",
      "@deepseek-ai/dsh-util-values": "0.1.5-rc.2"
    }
  }
}
